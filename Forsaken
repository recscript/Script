--// Remove Fog \\
local function removefog(state)
if not Lighting:GetAttribute("FogStart") then Lighting:SetAttribute("FogStart", Lighting.FogStart) end
if not Lighting:GetAttribute("FogEnd") then Lighting:SetAttribute("FogEnd", Lighting.FogEnd) end
game.Lighting.FogStart = state and 0 or Lighting:GetAttribute("FogStart")
game.Lighting.FogEnd = state and math.huge or Lighting:GetAttribute("FogEnd")
local fog = Lighting:FindFirstChildOfClass("Atmosphere")
if fog then
if not fog:GetAttribute("Density") then fog:SetAttribute("Density", fog.Density) end
fog.Density = state and 0 or fog:GetAttribute("Density")
end
end
--// Fullbright \\
local function fullbright(state)
if state then
Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
Lighting.Brightness = 1.5
Lighting.GlobalShadows = false
end
end
