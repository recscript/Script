local tool = LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
if tool then
Character.Humanoid:EquipTool(tool)
end
end
if _G.AutoSkipWave then
ReplicatedStorage:WaitForChild("WaveRemotes"):WaitForChild("SkipVote"):FireServer(true)
end
