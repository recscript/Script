local function Highlight(v, color, name)
if v:FindFirstChild(name) then return end
local hl = Instance.new('Highlight', v)
hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
hl.FillColor = color
hl.OutlineColor = color
hl.FillTransparency = 0.8
hl.OutlineTransparency = 0
hl.Name = name
end

RunService.Heartbeat:Connect(function()
if not Character or not Character:FindFirstChild("HumanoidRootPart") then
Character = LocalPlayer.Character
if Character then
Root = Character:FindFirstChild("HumanoidRootPart")
end
return
end
if not _G.WaveFarm then
OldPosition = Root.CFrame
end
if _G.WaveFarm then
Root.CFrame = CFrame.new(-348.26, 1000.98, -307.78)
workspace.Gravity = 0
task.wait()
else
workspace.Gravity = Default.Gravity
Root.CFrame = OldPosition
end
if _G.AutoPlayAgain then
game:GetService("ReplicatedStorage"):WaitForChild("GameStateRemotes"):WaitForChild("VotePlayAgain"):FireServer()
end
if _G.AutoResetAfterWave then
local Wave = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("MainGui"):FindFirstChild("WaveLabel")
if Wave and Wave.Text == "Wave " .. ((_G.ResetAfterWave or 50) + 1) .. " Has Started" then
game.Players.LocalPlayer.Character.Humanoid.Health = 0     
else
warn("Lỗi Error")
end
end
