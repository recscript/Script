local Default = {
Brightness = game.Lighting.Brightness,
OutdoorAmbient = game.Lighting.OutdoorAmbient,
FogEnd = game.Lighting.FogEnd
}
game:GetService("RunService").RenderStepped:Connect(function()
workspace.Camera.FieldOfView = getgenv().fv or 70
if getgenv().f then
game.Lighting.GlobalShadows = false
game.Lighting.Brightness = getgenv().b or 1
game.Lighting.OutdoorAmbient = getgenv().odc or Color3.fromRGB(255,255,255)
else
game.Lighting.GlobalShadows = false
game.Lighting.Brightness = Default.Brightness
game.Lighting.OutdoorAmbient = Default.OutdoorAmbient
end
if getgenv().rf then
game.Lighting.FogEnd = 9e9
else
game.Lighting.FogEnd = Default.FogEnd
end
end)
