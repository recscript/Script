for _,v in ipairs(workspace:GetDescendants()) do
if v:IsA("ProximityPrompt") then
spawn(function()
while true do
v.HoldDuration = 0
wait()
end
end)
end
end
InstantInterest = workspace.DescendantAdded:Connect(function(v)
if v:IsA("ProximityPrompt") then
spawn(function()
while true do
v.HoldDuration = 0
wait()
end
end)
end
end)
else
InstantInterest:Disconnect()
end
end})
