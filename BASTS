







local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Aculiet Hub",
    SubTitle = "v0.0.1",
    TabWidth = 160,
    Size = UDim2.fromOffset(380, 260),
    Acrylic = false, -- Tắt để giảm tối đa lag trên mobile
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.F11
})

local Tabs = {
    Main = Window:AddTab({ Title = "Main", Icon = "" })
}

local AFpos = game:GetService("Players").LocalPlayer.Character and (game:GetService("Players").LocalPlayer.Character:FindFirstChild("Head") and game:GetService("Players").LocalPlayer.Character.Head.Position - Vector3.new(0,-5000,0)) or Vector3.new(0,0,0)
local oldpos = nil

-- ==========================================
-- CHUYỂN ĐỔI TÍNH NĂNG TỪ FLUX SANG FLUENT
-- ==========================================

-- Hide Limit Wall
local HideLimitWallToggle = Tabs.Main:AddToggle("HideLimitWall", {Title = "Hide Limit Wall", Default = false})
HideLimitWallToggle:OnChanged(function(v)
    _G.HideLimitWall = v
end)

-- Auto Farm
local AutoFarmToggle = Tabs.Main:AddToggle("AutoFarm", {Title = "Auto Farm", Default = false})
AutoFarmToggle:OnChanged(function(v)
    local char = game:GetService("Players").LocalPlayer.Character
    if char and char:FindFirstChild("Head") then
        oldpos = char.Head.Position
    end
    wait(0.3)
    _G.AutoFarm = v
    if _G.AutoFarm == false and oldpos and char and char:FindFirstChild("Head") then
        char.Head.CFrame = CFrame.new(oldpos)
        char.Head.Anchored = true
        wait(0.5)
        char.Head.Anchored = false
    end
end)

-- Monsters ESP
local MonstersESPToggle = Tabs.Main:AddToggle("MonstersESP", {Title = "Monsters ESP", Default = false})
MonstersESPToggle:OnChanged(function(v)
    _G.MonstersESP = v
end)

-- Behind Monsters
local BehindMonstersToggle = Tabs.Main:AddToggle("BehindMonsters", {Title = "Down Monsters", Default = false})
BehindMonstersToggle:OnChanged(function(v)
    _G.BehindMonsters = v
end)

-- ==========================================
-- VÒNG LẶP XỬ LÝ LOGIC GAME
-- ==========================================
game:GetService("RunService").Heartbeat:Connect(function()
    local Character = game:GetService("Players").LocalPlayer.Character
    if not Character then return end
    
    -- Hide Limit Wall
    for _, v in ipairs(workspace:GetChildren()) do
        if v.Name == "Part" then
            v.CanCollide = not _G.HideLimitWall
            v.Transparency = _G.HideLimitWall and 1 or 0
        end
    end
    
    -- Auto Farm
    if _G.AutoFarm and Character:FindFirstChild("HumanoidRootPart") then
        Character.HumanoidRootPart.CFrame = CFrame.new(AFpos)
    end
    
    -- Monsters ESP
    for _, v in ipairs(workspace:GetChildren()) do
        if _G.MonstersESP then
            if (v.Name == "Cinos" or v.Name == "Mouse") and v:IsA("Model") and not v:FindFirstChild("Monsters_ESP") then
                local m_h = Instance.new("Highlight", v)
                m_h.Name = "Monsters_ESP"
                m_h.OutlineColor = Color3.fromRGB(255, 255, 255)
            end
        else
            if v:FindFirstChild("Monsters_ESP") then
                v.Monsters_ESP:Destroy()
            end
        end
    end
    -- Behind Monsters
    for _, v in ipairs(workspace:GetChildren()) do
        if _G.BehindMonsters then
            if (v.Name == "Cinos" or v.Name == "Mouse") and v:IsA("Model") then
               Character.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame - Vector3.new(0,25,0)
            end
        end
    end
end)

Window:SelectTab(1)
