local AFpos = game:GetService("Players").LocalPlayer.Character.Head.Position - Vector3.new(0,-5000,0)

local Flux = loadstring(game:HttpGet"https://raw.githubusercontent.com/recscript/Library/refs/heads/main/FluxMobile")()
local Window = Flux:Window("Aculiet Hub", "v0.0.1", Color3.fromRGB(0,255,100), Enum.KeyCode.F9)
local Tab = Window:Tab("Main", "http://www.roblox.com/asset/?id=6023426915")
Tab:Toggle("Hide Limit Wall", "Hide all wall limit", function(v)
_G.HideLimitWall = v
end)
Tab:Toggle("Auto Farm", "Auto farm cash & win", function(v)
local oldpos = game:GetService("Players").LocalPlayer.Character.Head.Position
wait(0.3)
_G.AutoFarm = v
if _G.AutoFarm == false then
game:GetService("Players").LocalPlayer.Character.Head.CFrame = oldpos
end
end)
Tab:Toggle("Monsters ESP", "Monsters esp can help you identify it", function(v)
_G.MonstersESP = v
end)
Tab:Toggle("Anti Monsters", "You will dont bag dmg form monsters", function(v)
_G.AntiMonsters = v
end)
Tab:Toggle("Behind Monsters (OP & Fun)", "You will always behind monsters you very safe", function(v)
_G.BehindMonsters = v
end)
game:GetService("RunService").Heartbeat:Connect(function()
local Character = game:GetService("Players").LocalPlayer.Character
if not Character then return end
for _,v in ipairs(workspace:GetChildren()) do
if v.Name == "Part" then
v.CanCollide = not _G.HideLimitWall
v.Transparency = _G.HideLimitWall and 1 or 0
end
end
if _G.AutoFarm then
Character.HumanoidRootPart.CFrame = AFpos
end
for _,v in ipairs(workspace:GetChildren()) do
if _G.MonstersESP then
if v:IsA("Model") and not v:FindFirstChild("Monsters_ESP") then
local m_h = Instance.new("Highlight",v)
m_h.Name = "Monsters_ESP"
m_h.OutlineColor = Color3.fromRGB(255)
end
else
if v:FindFirstChild("Monsters_ESP") then
m_h:Destroy()
end
end
end
for _,v in ipairs(workspace:GetChildren()) do
if v:IsA("Model") then
for _,v2 in ipairs(v:GetChildren()) do
if v2:IsA("BasePart") then
v2.CanCollide = not _G.AntiMonsters
v2.CanTouch = not _G.AntiMonsters
end
end
end
end
end)




