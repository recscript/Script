function FlingMurderer()
    local lp = game.Players.LocalPlayer
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local targetHrp = Murderer():FindFirstChild("HumanoidRootPart")

    if hrp and targetHrp then
        local oldPos = hrp.CFrame
        local th = instance.new("BodyAngularVelocity")
        th.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        th.P = 1000000
        th.AngularVelocity = Vector3.new(0, 50000000, 0)
        th.Parent = hrp
        
        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1)
        task.wait(0.3)
        

        th:Destroy()
        hrp.CFrame = oldPos
    end
end
